#include <iostream>
#include <vector>
#include <climits>
using namespace std;

struct Edge {
    int u, v, weight;
};

void bellmanFord(int V, int E, vector<Edge>& edges, int src) {
    vector<long long> dist(V, LLONG_MAX);

    dist[src] = 0;

    // Relax all edges V-1 times
    for (int i = 1; i <= V - 1; i++) {
        bool updated = false;

        for (const Edge& edge : edges) {
            int u = edge.u;
            int v = edge.v;
            int w = edge.weight;

            if (dist[u] != LLONG_MAX &&
                dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                updated = true;
            }
        }

        // Optimization: stop if no distance changes
        if (!updated)
            break;
    }

    // Check for a negative-weight cycle
    for (const Edge& edge : edges) {
        int u = edge.u;
        int v = edge.v;
        int w = edge.weight;

        if (dist[u] != LLONG_MAX &&
            dist[u] + w < dist[v]) {
            cout << "Negative-weight cycle detected!\n";
            return;
        }
    }

    cout << "Shortest distances from source "
         << src << ":\n";

    for (int i = 0; i < V; i++) {
        cout << "Vertex " << i << " : ";

        if (dist[i] == LLONG_MAX)
            cout << "INF\n";
        else
            cout << dist[i] << '\n';
    }
}

int main() {
    int V = 5, E = 8;

    vector<Edge> edges = {
        {0, 1, -1},
        {0, 2, 4},
        {1, 2, 3},
        {1, 3, 2},
        {1, 4, 2},
        {3, 2, 5},
        {3, 1, 1},
        {4, 3, -3}
    };

    int source = 0;

    bellmanFord(V, E, edges, source);

    return 0;
}
