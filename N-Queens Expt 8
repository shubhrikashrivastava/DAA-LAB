#include <iostream>
#include <vector>
using namespace std;

bool isSafe(vector<string>& board, int row, int col, int n) {
    // Check the same column above
    for (int i = 0; i < row; i++) {
        if (board[i][col] == 'Q')
            return false;
    }

    // Check upper-left diagonal
    for (int i = row - 1, j = col - 1;
         i >= 0 && j >= 0; i--, j--) {
        if (board[i][j] == 'Q')
            return false;
    }

    // Check upper-right diagonal
    for (int i = row - 1, j = col + 1;
         i >= 0 && j < n; i--, j++) {
        if (board[i][j] == 'Q')
            return false;
    }

    return true;
}

bool solveNQueens(vector<string>& board, int row, int n) {
    // All queens have been placed
    if (row == n)
        return true;

    // Try placing a queen in each column
    for (int col = 0; col < n; col++) {
        if (isSafe(board, row, col, n)) {
            board[row][col] = 'Q';

            // Recursively place queens in next rows
            if (solveNQueens(board, row + 1, n))
                return true;

            // Backtrack
            board[row][col] = '.';
        }
    }

    return false;
}

int main() {
    int n;
    cout << "Enter the value of N: ";
    cin >> n;

    if (n <= 0) {
        cout << "N must be positive.\n";
        return 0;
    }

    vector<string> board(n, string(n, '.'));

    if (solveNQueens(board, 0, n)) {
        cout << "Solution:\n";
        for (int i = 0; i < n; i++) {
            cout << board[i] << '\n';
        }
    } else {
        cout << "No solution exists.\n";
    }

    return 0;
}
